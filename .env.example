# MLflow tracking server — shared by docker-compose and scripts/
MLFLOW_TRACKING_URI=http://localhost:5000

# Backend store (run, param, metric, registry metadata)
BACKEND_STORE_URI=sqlite:///../mlflow-data/mlflow.db

# Artifact store (model files, preprocessor, etc.)
ARTIFACT_ROOT=../mlflow-artifacts

# Model name to look up in the registry
MODEL_NAME=BankChurnModel

# Stage to serve
MODEL_STAGE=Production

# Port the served model listens on
SERVING_PORT=5001